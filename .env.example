# NetScope Environment Configuration Template

# Server & Ingestion
NETSCOPE_ENV=development
NETSCOPE_PORT=8000
NETSCOPE_HOST=0.0.0.0
NETSCOPE_SECRET_KEY=change-this-in-production-super-secret-key-32chars
NETSCOPE_ALGORITHM=HS256
NETSCOPE_ACCESS_TOKEN_EXPIRE_MINUTES=60
NETSCOPE_REFRESH_TOKEN_EXPIRE_DAYS=7

# PostgreSQL / TimescaleDB
POSTGRES_USER=netscope
POSTGRES_PASSWORD=netscope_secure_password
POSTGRES_DB=netscope_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://netscope:netscope_secure_password@postgres:5432/netscope_db
DATABASE_SYNC_URL=postgresql://netscope:netscope_secure_password@postgres:5432/netscope_db

# Redis & Celery
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/v1/ws/live

# Go Agent Defaults
NETSCOPE_AGENT_SERVER=http://localhost:8000
NETSCOPE_AGENT_ENROLL_TOKEN=
NETSCOPE_AGENT_POLL_INTERVAL=30s
NETSCOPE_AGENT_RATE_LIMIT=150
